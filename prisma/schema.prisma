// Prisma Schema for Golf Tournament Management
// Generator and Datasource

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE DOMAIN: PLAYER MANAGEMENT
// ============================================================================

enum MembershipType {
  MEMBER
  GUEST
  CORPORATE
  TRIAL
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Player {
  id             String         @id @default(cuid())
  memberNumber   String?        @unique // PC Caddie sync
  firstName      String
  lastName       String
  email          String         @unique
  phone          String?
  dateOfBirth    DateTime?
  gender         Gender?

  // Handicap
  handicapIndex  Decimal        @db.Decimal(4, 1) // -10.0 to 54.0
  homeClub       String?
  whsId          String?        @unique // World Handicap System ID

  // Membership
  membershipType MembershipType @default(GUEST)
  memberSince    DateTime?

  // DSGVO
  consentGiven   Boolean        @default(false)
  consentDate    DateTime?
  marketingConsent Boolean      @default(false)

  // Metadata
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  registrations  Registration[]
  scorecards     Scorecard[]
  user           User?          @relation(fields: [userId], references: [id])
  userId         String?        @unique

  @@index([email])
  @@index([memberNumber])
  @@index([whsId])
}

// ============================================================================
// CORE DOMAIN: TOURNAMENT MANAGEMENT
// ============================================================================

enum TournamentFormat {
  STROKE_PLAY
  STABLEFORD
  MATCH_PLAY
  SCRAMBLE
  BEST_BALL
  FOUR_BALL
  NASSAU
}

enum TournamentStatus {
  DRAFT
  OPEN_FOR_REGISTRATION
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum TournamentCategory {
  CLUB_CHAMPIONSHIP
  MONTHLY_MEDAL
  CORPORATE_EVENT
  CHARITY
  MEMBER_GUEST
  PRO_AM
  CASUAL
}

model Tournament {
  id                String              @id @default(cuid())
  name              String
  description       String?             @db.Text
  format            TournamentFormat
  category          TournamentCategory  @default(CASUAL)
  status            TournamentStatus    @default(DRAFT)

  // Dates
  tournamentDate    DateTime
  registrationStart DateTime
  registrationEnd   DateTime

  // Course Setup
  courseId          String?
  course            Course?             @relation(fields: [courseId], references: [id])
  teesUsed          Json                // { "men": "white", "women": "red" }

  // Limits
  maxPlayers        Int?
  minPlayers        Int                 @default(4)
  entryFee          Decimal?            @db.Decimal(10, 2)

  // Flights & Divisions
  autoGenerateFlights Boolean           @default(true)
  flightsPerTee     Int                 @default(15) // minutes between flights

  // Sponsorship
  sponsorPackages   Json?               // Flexible JSON for sponsor tiers

  // Settings
  allowGuests       Boolean             @default(true)
  requireHandicap   Boolean             @default(true)
  maxHandicap       Decimal?            @db.Decimal(4, 1)

  // Metadata
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  createdBy         String?
  creator           User?               @relation(fields: [createdBy], references: [id])

  // Relations
  registrations     Registration[]
  flights           Flight[]
  scorecards        Scorecard[]
  sponsors          Sponsor[]

  @@index([tournamentDate])
  @@index([status])
}

model Course {
  id          String   @id @default(cuid())
  name        String
  location    String?
  holes       Int      @default(18)
  par         Int      @default(72)

  // Tees (stored as JSON for flexibility)
  tees        Json     // [{ name: "Championship", color: "black", rating: 74.2, slope: 142, yardage: 7200 }]

  // Hole details
  holeDetails Json     // [{ hole: 1, par: 4, handicap: 10, yardages: { black: 420, white: 380 } }]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tournaments Tournament[]
}

model Flight {
  id            String     @id @default(cuid())
  tournamentId  String
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  flightNumber  Int
  startTime     DateTime
  startHole     Int        @default(1)

  // Relations
  registrations Registration[]

  @@unique([tournamentId, flightNumber])
  @@index([tournamentId])
}

// ============================================================================
// REGISTRATION & PARTICIPATION
// ============================================================================

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WAITLIST
  CANCELLED
  NO_SHOW
}

model Registration {
  id              String             @id @default(cuid())

  // Relations
  tournamentId    String
  tournament      Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerId        String
  player          Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  flightId        String?
  flight          Flight?            @relation(fields: [flightId], references: [id])

  // Registration details
  status          RegistrationStatus @default(PENDING)
  registeredAt    DateTime           @default(now())
  playingHandicap Decimal?           @db.Decimal(4, 1) // Calculated at time of registration
  tee             String?            // Which tee they'll play from

  // Payment
  paid            Boolean            @default(false)
  paidAt          DateTime?
  paymentMethod   String?

  // Special requests
  specialRequests String?            @db.Text
  cart            Boolean            @default(false)

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([tournamentId, playerId])
  @@index([tournamentId])
  @@index([playerId])
}

// ============================================================================
// SCORING SYSTEM
// ============================================================================

enum ScorecardStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  VERIFIED
  DISQUALIFIED
}

model Scorecard {
  id           String          @id @default(cuid())

  // Relations
  tournamentId String
  tournament   Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // Scoring
  scores       Json            // [{ hole: 1, gross: 5, putts: 2, fairwayHit: true, greenInRegulation: false }]
  totalGross   Int?
  totalNet     Int?
  totalPoints  Int?            // Stableford points

  // Status
  status       ScorecardStatus @default(NOT_STARTED)
  startedAt    DateTime?
  submittedAt  DateTime?
  verifiedAt   DateTime?

  // Attestation
  markerName   String?
  markerSignature String?      // Digital signature or PIN

  // Metadata
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([tournamentId, playerId])
  @@index([tournamentId])
  @@index([status])
}

// ============================================================================
// SPONSORSHIP
// ============================================================================

enum SponsorTier {
  PLATINUM
  GOLD
  SILVER
  BRONZE
  HOLE_SPONSOR
}

model Sponsor {
  id              String      @id @default(cuid())
  name            String
  logo            String?     // URL to logo
  website         String?
  contactPerson   String?
  contactEmail    String?
  contactPhone    String?

  tier            SponsorTier

  // Tournament relation
  tournamentId    String
  tournament      Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  // Activation
  activationPoints Json?      // { holes: [3, 7, 15], qrCodes: true, banners: 2 }

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([tournamentId])
}

// ============================================================================
// AUTHENTICATION & AUTHORIZATION
// ============================================================================

enum UserRole {
  ADMIN
  TOURNAMENT_MANAGER
  MARSHAL
  PRO_SHOP
  PLAYER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(PLAYER)

  // Relations
  accounts      Account[]
  sessions      Session[]
  player        Player?
  tournaments   Tournament[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
}

// NextAuth.js Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// PC CADDIE INTEGRATION (Sync tracking)
// ============================================================================

model SyncLog {
  id          String   @id @default(cuid())
  entity      String   // "player", "handicap", "tournament"
  externalId  String   // PC Caddie ID
  internalId  String   // Our ID
  syncedAt    DateTime @default(now())
  status      String   // "success", "error"
  errorMessage String? @db.Text

  @@index([entity, externalId])
  @@index([syncedAt])
}
