// Prisma Schema for Golf Tournament Management
// Generator and Datasource

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE DOMAIN: PLAYER MANAGEMENT
// ============================================================================

enum MembershipType {
  MEMBER
  GUEST
  CORPORATE
  TRIAL
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Player {
  id             String         @id @default(cuid())
  memberNumber   String?        @unique // PC Caddie sync
  firstName      String
  lastName       String
  email          String         @unique
  phone          String?
  dateOfBirth    DateTime?
  gender         Gender?

  // Handicap
  handicapIndex  Decimal        @db.Decimal(4, 1) // -10.0 to 54.0
  homeClub       String?
  whsId          String?        @unique // World Handicap System ID

  // Membership
  membershipType MembershipType @default(GUEST)
  memberSince    DateTime?

  // DSGVO
  consentGiven   Boolean        @default(false)
  consentDate    DateTime?
  marketingConsent Boolean      @default(false)

  // Metadata
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  registrations  Registration[]
  scorecards     Scorecard[]
  user           User?          @relation(fields: [userId], references: [id])
  userId         String?        @unique

  @@index([email])
  @@index([memberNumber])
  @@index([whsId])
}

// ============================================================================
// CORE DOMAIN: TOURNAMENT MANAGEMENT
// ============================================================================

enum TournamentFormat {
  STROKE_PLAY
  STABLEFORD
  MATCH_PLAY
  SCRAMBLE
  BEST_BALL
  FOUR_BALL
  NASSAU
}

enum TournamentStatus {
  DRAFT
  OPEN_FOR_REGISTRATION
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum TournamentCategory {
  CLUB_CHAMPIONSHIP
  MONTHLY_MEDAL
  CORPORATE_EVENT
  CHARITY
  MEMBER_GUEST
  PRO_AM
  CASUAL
}

model Tournament {
  id                String              @id @default(cuid())
  name              String
  description       String?             @db.Text
  format            TournamentFormat
  category          TournamentCategory  @default(CASUAL)
  status            TournamentStatus    @default(DRAFT)

  // Dates
  tournamentDate    DateTime
  registrationStart DateTime
  registrationEnd   DateTime

  // Course Setup
  courseId          String?
  course            Course?             @relation(fields: [courseId], references: [id])
  teesUsed          Json                // { "men": "white", "women": "red" }

  // Limits
  maxPlayers        Int?
  minPlayers        Int                 @default(4)
  entryFee          Decimal?            @db.Decimal(10, 2)

  // Flights & Divisions
  autoGenerateFlights Boolean           @default(true)
  flightsPerTee     Int                 @default(15) // minutes between flights

  // Sponsorship
  sponsorPackages   Json?               // Flexible JSON for sponsor tiers

  // Settings
  allowGuests       Boolean             @default(true)
  requireHandicap   Boolean             @default(true)
  maxHandicap       Decimal?            @db.Decimal(4, 1)

  // Multi-club support
  clubId            String?
  club              Club?               @relation(fields: [clubId], references: [id])

  // Metadata
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  createdBy         String?
  creator           User?               @relation(fields: [createdBy], references: [id])

  // Relations
  registrations     Registration[]
  flights           Flight[]
  scorecards        Scorecard[]
  sponsors          Sponsor[]
  photos            Photo[]

  @@index([tournamentDate])
  @@index([status])
  @@index([clubId])
}

model Course {
  id          String   @id @default(cuid())
  name        String
  location    String?
  holes       Int      @default(18)
  par         Int      @default(72)

  // Tees (stored as JSON for flexibility)
  tees        Json     // [{ name: "Championship", color: "black", rating: 74.2, slope: 142, yardage: 7200 }]

  // Hole details
  holeDetails Json     // [{ hole: 1, par: 4, handicap: 10, yardages: { black: 420, white: 380 } }]

  // Multi-club support
  clubId      String?
  club        Club?    @relation(fields: [clubId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tournaments Tournament[]

  @@index([clubId])
}

model Flight {
  id            String     @id @default(cuid())
  tournamentId  String
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  flightNumber  Int
  startTime     DateTime
  startHole     Int        @default(1)

  // Relations
  registrations Registration[]

  @@unique([tournamentId, flightNumber])
  @@index([tournamentId])
}

// ============================================================================
// REGISTRATION & PARTICIPATION
// ============================================================================

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WAITLIST
  CANCELLED
  NO_SHOW
}

model Registration {
  id              String             @id @default(cuid())

  // Relations
  tournamentId    String
  tournament      Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerId        String
  player          Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  flightId        String?
  flight          Flight?            @relation(fields: [flightId], references: [id])

  // Registration details
  status          RegistrationStatus @default(PENDING)
  registeredAt    DateTime           @default(now())
  playingHandicap Decimal?           @db.Decimal(4, 1) // Calculated at time of registration
  tee             String?            // Which tee they'll play from

  // Payment
  paid            Boolean            @default(false)
  paidAt          DateTime?
  paymentMethod   String?

  // Special requests
  specialRequests String?            @db.Text
  cart            Boolean            @default(false)

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([tournamentId, playerId])
  @@index([tournamentId])
  @@index([playerId])
}

// ============================================================================
// SCORING SYSTEM
// ============================================================================

enum ScorecardStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  VERIFIED
  DISQUALIFIED
}

model Scorecard {
  id           String          @id @default(cuid())

  // Relations
  tournamentId String
  tournament   Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // Scoring
  scores       Json            // [{ hole: 1, gross: 5, putts: 2, fairwayHit: true, greenInRegulation: false }]
  totalGross   Int?
  totalNet     Int?
  totalPoints  Int?            // Stableford points

  // Status
  status       ScorecardStatus @default(NOT_STARTED)
  startedAt    DateTime?
  submittedAt  DateTime?
  verifiedAt   DateTime?

  // Attestation
  markerName   String?
  markerSignature String?      // Digital signature or PIN

  // Metadata
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([tournamentId, playerId])
  @@index([tournamentId])
  @@index([status])
}

// ============================================================================
// SPONSORSHIP
// ============================================================================

enum SponsorTier {
  PLATINUM
  GOLD
  SILVER
  BRONZE
  HOLE_SPONSOR
}

model Sponsor {
  id              String      @id @default(cuid())
  name            String
  logo            String?     // URL to logo
  website         String?
  contactPerson   String?
  contactEmail    String?
  contactPhone    String?

  tier            SponsorTier

  // Tournament relation
  tournamentId    String
  tournament      Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  // Activation
  activationPoints Json?      // { holes: [3, 7, 15], qrCodes: true, banners: 2 }

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([tournamentId])
}

// ============================================================================
// AUTHENTICATION & AUTHORIZATION
// ============================================================================

enum UserRole {
  ADMIN
  TOURNAMENT_MANAGER
  MARSHAL
  PRO_SHOP
  PLAYER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(PLAYER)

  // Relations
  accounts      Account[]
  sessions      Session[]
  player        Player?
  tournaments   Tournament[]
  photos        Photo[]
  reports       Report[]
  pushSubscriptions PushSubscription[]
  clubMemberships ClubMember[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
}

// NextAuth.js Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// PC CADDIE INTEGRATION (Sync tracking)
// ============================================================================

model SyncLog {
  id          String   @id @default(cuid())
  entity      String   // "player", "handicap", "tournament"
  externalId  String   // PC Caddie ID
  internalId  String   // Our ID
  syncedAt    DateTime @default(now())
  status      String   // "success", "error"
  errorMessage String? @db.Text

  @@index([entity, externalId])
  @@index([syncedAt])
}

// ============================================================================
// PHOTO GALLERY (Phase 3)
// ============================================================================

enum PhotoCategory {
  TOURNAMENT
  COURSE
  CLUBHOUSE
  SOCIAL
  AWARDS
  ACTION_SHOT
}

model Photo {
  id            String        @id @default(cuid())

  // File information
  filename      String
  originalName  String
  mimeType      String
  fileSize      Int           // bytes
  width         Int
  height        Int

  // Storage
  url           String        // Original
  thumbnailUrl  String?       // 200x200
  mediumUrl     String?       // 800x800

  // Metadata
  caption       String?       @db.Text
  category      PhotoCategory @default(TOURNAMENT)
  takenAt       DateTime?

  // Relations
  tournamentId  String?
  tournament    Tournament?   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  uploadedBy    String?
  uploader      User?         @relation(fields: [uploadedBy], references: [id])
  albumId       String?
  album         Album?        @relation(fields: [albumId], references: [id])

  // Visibility
  isPublic      Boolean       @default(true)
  isFeatured    Boolean       @default(false)

  // Moderation
  approved      Boolean       @default(false)
  moderatedBy   String?
  moderatedAt   DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tournamentId])
  @@index([uploadedBy])
  @@index([category])
  @@index([createdAt])
}

model Album {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  coverPhotoId String?

  // Relations
  photos      Photo[]

  // Visibility
  isPublic    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

// ============================================================================
// ANALYTICS & REPORTS (Phase 3)
// ============================================================================

enum MetricType {
  TOURNAMENT_PARTICIPATION
  PLAYER_PERFORMANCE
  REVENUE
  REGISTRATION_CONVERSION
  SCORECARD_COMPLETION
  AVERAGE_SCORE
  HANDICAP_DISTRIBUTION
}

model AnalyticsMetric {
  id          String     @id @default(cuid())
  metricType  MetricType

  // Dimensions
  tournamentId String?
  playerId     String?
  date         DateTime

  // Metric values
  value        Decimal    @db.Decimal(10, 2)
  count        Int?
  metadata     Json?      // Additional metric-specific data

  createdAt    DateTime   @default(now())

  @@index([metricType, date])
  @@index([tournamentId])
  @@index([playerId])
  @@index([date])
}

enum ReportType {
  TOURNAMENT_SUMMARY
  PLAYER_PERFORMANCE
  FINANCIAL
  PARTICIPATION_TRENDS
  HANDICAP_ANALYSIS
  CUSTOM
}

enum ReportFormat {
  PDF
  EXCEL
  CSV
  JSON
}

model Report {
  id          String       @id @default(cuid())
  title       String
  reportType  ReportType
  format      ReportFormat @default(PDF)

  // Generation
  parameters  Json         // Report-specific parameters
  fileUrl     String?      // Generated report file
  fileSize    Int?         // bytes

  // Relations
  generatedBy String?
  generator   User?        @relation(fields: [generatedBy], references: [id])

  // Metadata
  generatedAt DateTime     @default(now())
  expiresAt   DateTime?    // Auto-delete old reports

  @@index([reportType])
  @@index([generatedBy])
  @@index([generatedAt])
}

// ============================================================================
// PUSH NOTIFICATIONS (Phase 3)
// ============================================================================

model PushSubscription {
  id          String   @id @default(cuid())

  // Web Push subscription data
  endpoint    String   @unique
  p256dh      String   // Public key
  auth        String   // Auth secret

  // User relation
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId    String?

  // Device info
  userAgent   String?  @db.Text
  deviceType  String?  // "mobile", "desktop", "tablet"

  // Preferences
  enabled     Boolean  @default(true)
  topics      String[] // ["tournaments", "scores", "announcements"]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastUsedAt  DateTime @default(now())

  @@index([userId])
  @@index([enabled])
}

model NotificationLog {
  id          String   @id @default(cuid())

  // Notification details
  title       String
  body        String   @db.Text
  icon        String?
  badge       String?
  url         String?  // Click action URL

  // Targeting
  userId      String?
  tournamentId String?
  topic       String?  // Broadcast topic

  // Delivery
  sentAt      DateTime @default(now())
  delivered   Int      @default(0) // Count of successful deliveries
  failed      Int      @default(0) // Count of failed deliveries

  // Metadata
  metadata    Json?

  @@index([userId])
  @@index([tournamentId])
  @@index([sentAt])
}

// ============================================================================
// MULTI-CLUB SUPPORT (Phase 4)
// ============================================================================

enum ClubTier {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

model Club {
  id              String       @id @default(cuid())

  // Basic info
  name            String
  slug            String       @unique
  description     String?      @db.Text
  logo            String?
  website         String?

  // Contact
  email           String
  phone           String?
  address         String?
  city            String?
  postalCode      String?
  country         String       @default("DE")

  // Branding (White-label)
  primaryColor    String?      @default("#16a34a")
  secondaryColor  String?
  customDomain    String?      @unique

  // Subscription
  tier            ClubTier     @default(FREE)
  subscriptionId  String?      @unique // Stripe subscription ID
  trialEndsAt     DateTime?
  activeUntil     DateTime?

  // Features
  maxTournaments  Int?         // null = unlimited
  maxPlayers      Int?
  features        Json         // Feature flags

  // Settings
  settings        Json?        // Club-specific settings

  // Relations
  courses         Course[]
  users           ClubMember[]
  tournaments     Tournament[]

  // Status
  isActive        Boolean      @default(true)
  isSuspended     Boolean      @default(false)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([slug])
  @@index([tier])
  @@index([isActive])
}

enum ClubMemberRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  MEMBER
}

model ClubMember {
  id        String         @id @default(cuid())

  clubId    String
  club      Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)

  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  role      ClubMemberRole @default(MEMBER)

  joinedAt  DateTime       @default(now())

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
}
