# Test Environment Variables

# Database - Use separate test database
DATABASE_URL="postgresql://user:password@localhost:5432/golf_tournament_test?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="test-secret-key-for-automated-tests"

# Brevo (Mock in tests)
BREVO_API_KEY="test-brevo-api-key"
BREVO_SENDER_EMAIL="test@test.com"
BREVO_SENDER_NAME="Test Golf Club"

# Stripe (Test Mode)
STRIPE_SECRET_KEY="sk_test_mock_key"
STRIPE_PUBLISHABLE_KEY="pk_test_mock_key"
STRIPE_WEBHOOK_SECRET="whsec_test_mock"

# Feature Flags
FEATURE_QR_SCORING="true"
FEATURE_LIVE_LEADERBOARD="true"
FEATURE_SPONSOR_ACTIVATION="true"

# VAPID Keys (Test)
VAPID_PUBLIC_KEY="test-vapid-public-key"
VAPID_PRIVATE_KEY="test-vapid-private-key"
VAPID_SUBJECT="mailto:test@test.com"

# Multi-Club
NEXT_PUBLIC_MAIN_DOMAIN="localhost:3000"

# Upload Limits
UPLOAD_MAX_SIZE="10485760"
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,image/webp"
