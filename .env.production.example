# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.production and fill in all values
# NEVER commit .env.production to git!
# =============================================================================

# =============================================================================
# Core Configuration
# =============================================================================

NODE_ENV=production

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL 16+ connection string with SSL
# Use connection pooler (PgBouncer/Neon/Supabase pooler) for production
# Example formats:
#   Neon: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres?pgbouncer=true&sslmode=require
#   AWS RDS: postgresql://user:pass@xxx.rds.amazonaws.com:5432/golf_tournament?sslmode=require
#   Railway: postgresql://user:pass@host.railway.app:5432/railway?sslmode=require

DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Optional: Read replica for scaling (leave empty if not using)
DATABASE_REPLICA_URL=""

# =============================================================================
# NextAuth.js Configuration
# =============================================================================
# Public URL of your application (must match your domain)
NEXTAUTH_URL="https://yourdomain.com"

# Secret key for NextAuth.js encryption (REQUIRED - must be unique)
# Generate with: openssl rand -base64 32
# SECURITY: Use a strong random value, minimum 32 characters
NEXTAUTH_SECRET="REPLACE_WITH_GENERATED_SECRET"

# =============================================================================
# Brevo (Sendinblue) Email Service
# =============================================================================
# Get API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY="xkeysib-REPLACE_WITH_YOUR_API_KEY"

# Sender email (must be verified in Brevo)
# Verify domain: https://app.brevo.com/settings/senders
BREVO_SENDER_EMAIL="noreply@yourdomain.com"
BREVO_SENDER_NAME="Your Golf Club Name"

# =============================================================================
# Brevo Email Templates
# =============================================================================
# Create templates in Brevo Dashboard: https://app.brevo.com/camp/lists/template
# Then add the template IDs here
# Optional: If not set, will use default inline templates

BREVO_TEMPLATE_REGISTRATION_CONFIRMATION=""
BREVO_TEMPLATE_TOURNAMENT_REMINDER=""
BREVO_TEMPLATE_TOURNAMENT_STARTED=""
BREVO_TEMPLATE_TOURNAMENT_RESULTS=""
BREVO_TEMPLATE_SCORECARD_SUBMITTED=""
BREVO_TEMPLATE_PAYMENT_CONFIRMATION=""
BREVO_TEMPLATE_WELCOME=""

# =============================================================================
# Brevo Contact Lists
# =============================================================================
# Create lists in Brevo Dashboard: https://app.brevo.com/contact/lists
# Optional: If not set, contacts won't be synced to lists

BREVO_LIST_ALL_MEMBERS=""
BREVO_LIST_ACTIVE_PLAYERS=""
BREVO_LIST_TOURNAMENT_PARTICIPANTS=""

# =============================================================================
# Stripe Payment Integration
# =============================================================================
# IMPORTANT: Use LIVE keys for production!
# Get keys from: https://dashboard.stripe.com/apikeys

# Secret key (starts with sk_live_)
STRIPE_SECRET_KEY="sk_live_REPLACE_WITH_YOUR_SECRET_KEY"

# Publishable key (starts with pk_live_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_REPLACE_WITH_YOUR_PUBLISHABLE_KEY"

# Webhook signing secret (starts with whsec_)
# Create webhook endpoint: https://dashboard.stripe.com/webhooks
# Endpoint URL: https://yourdomain.com/api/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.*, payment_intent.*
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET"

# =============================================================================
# Stripe Subscription Prices
# =============================================================================
# Create products and prices: https://dashboard.stripe.com/products
# Get price IDs (start with price_)

STRIPE_PRICE_BASIC="price_REPLACE_WITH_BASIC_PRICE_ID"
STRIPE_PRICE_PREMIUM="price_REPLACE_WITH_PREMIUM_PRICE_ID"
STRIPE_PRICE_ENTERPRISE="price_REPLACE_WITH_ENTERPRISE_PRICE_ID"

# =============================================================================
# Web Push Notifications (VAPID)
# =============================================================================
# Generate VAPID keys with: pnpm generate-vapid
# REQUIRED for push notifications to work

VAPID_PUBLIC_KEY="REPLACE_WITH_GENERATED_PUBLIC_KEY"
VAPID_PRIVATE_KEY="REPLACE_WITH_GENERATED_PRIVATE_KEY"

# Contact email for push notification issues
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# =============================================================================
# Cron Jobs Configuration
# =============================================================================
# Secret for authenticating cron job requests
# Generate with: openssl rand -hex 32
# SECURITY: Must be a strong random value

CRON_SECRET="REPLACE_WITH_GENERATED_CRON_SECRET"

# =============================================================================
# Multi-Club Support
# =============================================================================
# Main domain for the platform (without protocol)
NEXT_PUBLIC_MAIN_DOMAIN="yourdomain.com"

# =============================================================================
# Photo Upload Storage
# =============================================================================
# Maximum file size in bytes (default: 10MB)
UPLOAD_MAX_SIZE="10485760"

# Allowed file types (comma-separated MIME types)
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,image/webp"

# =============================================================================
# S3-Compatible Storage (Optional - for photo storage)
# =============================================================================
# Required if using S3/R2/Spaces for photo storage
# Leave empty to use local file storage (not recommended for production)

# S3 endpoint URL
# AWS S3: https://s3.us-east-1.amazonaws.com
# CloudFlare R2: https://<account-id>.r2.cloudflarestorage.com
# DigitalOcean Spaces: https://nyc3.digitaloceanspaces.com
S3_ENDPOINT=""

# S3 bucket name
S3_BUCKET=""

# S3 access credentials
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# S3 region
# AWS: us-east-1, eu-west-1, etc.
# CloudFlare R2: auto
# DigitalOcean: nyc3, sfo3, etc.
S3_REGION=""

# Optional: Custom CDN URL for serving images
S3_CDN_URL=""

# =============================================================================
# Error Tracking (Sentry)
# =============================================================================
# Get DSN from: https://sentry.io/settings/projects/
# Highly recommended for production!

SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Sentry environment name
SENTRY_ENVIRONMENT="production"

# Sentry release version (auto-populated from package.json)
SENTRY_RELEASE=""

# =============================================================================
# Feature Flags
# =============================================================================
# Enable/disable features (true/false)

FEATURE_QR_SCORING="true"
FEATURE_LIVE_LEADERBOARD="true"
FEATURE_SPONSOR_ACTIVATION="true"
FEATURE_ANALYTICS="true"
FEATURE_PUSH_NOTIFICATIONS="true"

# =============================================================================
# Optional Integrations
# =============================================================================

# PC Caddie Integration (German golf management software)
PC_CADDIE_API_URL=""
PC_CADDIE_API_KEY=""
PC_CADDIE_CLUB_ID=""

# DGV/WHS Integration (German Golf Association)
DGV_API_URL=""
DGV_CLUB_NUMBER=""
DGV_API_KEY=""

# =============================================================================
# Redis Cache (Optional but Recommended)
# =============================================================================
# Redis connection string for caching and sessions
# Providers: Upstash (serverless), Railway, AWS ElastiCache
# Leave empty to skip caching (not recommended for production)

REDIS_URL=""

# Redis password (if required)
REDIS_PASSWORD=""

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level (error, warn, info, debug)
LOG_LEVEL="info"

# =============================================================================
# Security Configuration
# =============================================================================

# CORS allowed origins (comma-separated)
# Example: https://yourdomain.com,https://*.yourdomain.com
CORS_ALLOWED_ORIGINS="https://yourdomain.com,https://*.yourdomain.com"

# Rate limiting
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"

# =============================================================================
# Analytics (Optional)
# =============================================================================

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Plausible Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# =============================================================================
# NOTES
# =============================================================================
#
# 1. SECURITY:
#    - Never commit this file with real values to git
#    - Use environment variable management (Vercel, Railway, AWS Secrets Manager)
#    - Rotate secrets regularly (every 90-180 days)
#    - Use different values for each environment
#
# 2. REQUIRED VARIABLES:
#    - DATABASE_URL
#    - NEXTAUTH_URL
#    - NEXTAUTH_SECRET
#    - BREVO_API_KEY
#    - BREVO_SENDER_EMAIL
#    - STRIPE_SECRET_KEY
#    - NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
#    - VAPID_PUBLIC_KEY
#    - VAPID_PRIVATE_KEY
#    - CRON_SECRET
#    - NEXT_PUBLIC_MAIN_DOMAIN
#
# 3. RECOMMENDED FOR PRODUCTION:
#    - SENTRY_DSN (error tracking)
#    - REDIS_URL (caching and performance)
#    - S3_* (for photo storage)
#    - STRIPE_WEBHOOK_SECRET (for payment events)
#
# 4. TESTING:
#    - Test all environment variables after deployment
#    - Verify webhooks are receiving events
#    - Check logs for any missing environment variable errors
#
# 5. DOCUMENTATION:
#    - See docs/DEPLOYMENT.md for detailed setup instructions
#    - See docs/TROUBLESHOOTING.md for common issues
#
# =============================================================================
