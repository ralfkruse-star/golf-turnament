# =============================================================================
# STAGING ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.staging and fill in all values
# Staging should mirror production but use separate resources
# =============================================================================

# =============================================================================
# Core Configuration
# =============================================================================

NODE_ENV=production

# =============================================================================
# Database Configuration
# =============================================================================
# Use a separate database for staging!
# Never use production database for staging

DATABASE_URL="postgresql://user:password@staging-host:5432/golf_tournament_staging?sslmode=require"

# Optional: Read replica
DATABASE_REPLICA_URL=""

# =============================================================================
# NextAuth.js Configuration
# =============================================================================
# Use staging domain or subdomain
NEXTAUTH_URL="https://staging.yourdomain.com"

# Use different secret than production!
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_STAGING_SECRET"

# =============================================================================
# Brevo (Sendinblue) Email Service
# =============================================================================
# Recommendation: Use same Brevo account but different sender or test mode

BREVO_API_KEY="xkeysib-REPLACE_WITH_YOUR_API_KEY"

# Use staging email address or suffix
# Example: staging-noreply@yourdomain.com or noreply-staging@yourdomain.com
BREVO_SENDER_EMAIL="staging-noreply@yourdomain.com"
BREVO_SENDER_NAME="Golf Club (Staging)"

# =============================================================================
# Brevo Email Templates (Staging)
# =============================================================================
# Option 1: Use same templates as production
# Option 2: Create staging-specific templates for testing

BREVO_TEMPLATE_REGISTRATION_CONFIRMATION=""
BREVO_TEMPLATE_TOURNAMENT_REMINDER=""
BREVO_TEMPLATE_TOURNAMENT_STARTED=""
BREVO_TEMPLATE_TOURNAMENT_RESULTS=""
BREVO_TEMPLATE_SCORECARD_SUBMITTED=""
BREVO_TEMPLATE_PAYMENT_CONFIRMATION=""
BREVO_TEMPLATE_WELCOME=""

# =============================================================================
# Brevo Contact Lists (Staging)
# =============================================================================
# Recommendation: Create staging-specific lists

BREVO_LIST_ALL_MEMBERS=""
BREVO_LIST_ACTIVE_PLAYERS=""
BREVO_LIST_TOURNAMENT_PARTICIPANTS=""

# =============================================================================
# Stripe Payment Integration
# =============================================================================
# IMPORTANT: ALWAYS use TEST keys for staging!
# Get keys from: https://dashboard.stripe.com/test/apikeys

# Secret key (starts with sk_test_)
STRIPE_SECRET_KEY="sk_test_REPLACE_WITH_YOUR_TEST_SECRET_KEY"

# Publishable key (starts with pk_test_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_WITH_YOUR_TEST_PUBLISHABLE_KEY"

# Webhook signing secret for staging
# Create separate webhook endpoint: https://dashboard.stripe.com/test/webhooks
# Endpoint URL: https://staging.yourdomain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_WITH_STAGING_WEBHOOK_SECRET"

# =============================================================================
# Stripe Subscription Prices (Test Mode)
# =============================================================================
# Create test products and prices in Stripe test mode

STRIPE_PRICE_BASIC="price_REPLACE_WITH_TEST_BASIC_PRICE_ID"
STRIPE_PRICE_PREMIUM="price_REPLACE_WITH_TEST_PREMIUM_PRICE_ID"
STRIPE_PRICE_ENTERPRISE="price_REPLACE_WITH_TEST_ENTERPRISE_PRICE_ID"

# =============================================================================
# Web Push Notifications (VAPID)
# =============================================================================
# Option 1: Use same VAPID keys as production
# Option 2: Generate separate keys for staging
# Generate with: pnpm generate-vapid

VAPID_PUBLIC_KEY="REPLACE_WITH_GENERATED_PUBLIC_KEY"
VAPID_PRIVATE_KEY="REPLACE_WITH_GENERATED_PRIVATE_KEY"
VAPID_SUBJECT="mailto:staging@yourdomain.com"

# =============================================================================
# Cron Jobs Configuration
# =============================================================================
# Use different secret than production
# Generate with: openssl rand -hex 32

CRON_SECRET="REPLACE_WITH_STAGING_CRON_SECRET"

# =============================================================================
# Multi-Club Support
# =============================================================================
# Use staging domain
NEXT_PUBLIC_MAIN_DOMAIN="staging.yourdomain.com"

# =============================================================================
# Photo Upload Storage
# =============================================================================

UPLOAD_MAX_SIZE="10485760"
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,image/webp"

# =============================================================================
# S3-Compatible Storage (Staging)
# =============================================================================
# Recommendation: Use separate bucket for staging

S3_ENDPOINT=""
S3_BUCKET="golf-tournament-photos-staging"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""
S3_CDN_URL=""

# =============================================================================
# Error Tracking (Sentry)
# =============================================================================
# Recommendation: Use same Sentry project but different environment

SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="staging"
SENTRY_RELEASE=""

# =============================================================================
# Feature Flags (Staging)
# =============================================================================
# Staging is a good place to test new features before production

FEATURE_QR_SCORING="true"
FEATURE_LIVE_LEADERBOARD="true"
FEATURE_SPONSOR_ACTIVATION="true"
FEATURE_ANALYTICS="true"
FEATURE_PUSH_NOTIFICATIONS="true"

# Enable experimental features in staging
FEATURE_EXPERIMENTAL_UI="true"
FEATURE_BETA_FEATURES="true"

# =============================================================================
# Optional Integrations (Staging)
# =============================================================================
# Use test/sandbox endpoints if available

PC_CADDIE_API_URL=""
PC_CADDIE_API_KEY=""
PC_CADDIE_CLUB_ID=""

DGV_API_URL=""
DGV_CLUB_NUMBER=""
DGV_API_KEY=""

# =============================================================================
# Redis Cache (Optional)
# =============================================================================
# Recommendation: Use separate Redis instance for staging

REDIS_URL=""
REDIS_PASSWORD=""

# =============================================================================
# Logging Configuration
# =============================================================================
# More verbose logging in staging
LOG_LEVEL="debug"

# =============================================================================
# Security Configuration
# =============================================================================

CORS_ALLOWED_ORIGINS="https://staging.yourdomain.com,https://*.staging.yourdomain.com"

RATE_LIMIT_ENABLED="true"
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"

# =============================================================================
# Analytics (Optional)
# =============================================================================
# Recommendation: Use separate analytics properties for staging

NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# =============================================================================
# Staging-Specific Configuration
# =============================================================================

# Banner to indicate staging environment
NEXT_PUBLIC_ENVIRONMENT_BANNER="true"
NEXT_PUBLIC_ENVIRONMENT_NAME="Staging"

# Enable debug features
DEBUG_ENABLED="true"
NEXT_PUBLIC_DEBUG_MODE="true"

# Bypass certain checks (for testing)
BYPASS_EMAIL_VERIFICATION="false"
BYPASS_PAYMENT_VERIFICATION="false"

# =============================================================================
# Test Data Configuration
# =============================================================================

# Auto-seed test data on deployment
AUTO_SEED_ENABLED="false"

# Test user credentials (for automated testing)
TEST_USER_EMAIL="test@example.com"
TEST_USER_PASSWORD="Test123!@#"

# =============================================================================
# NOTES FOR STAGING ENVIRONMENT
# =============================================================================
#
# 1. PURPOSE OF STAGING:
#    - Test new features before production deployment
#    - QA testing and user acceptance testing
#    - Load testing and performance testing
#    - Integration testing with external services
#    - Training environment for new team members
#
# 2. DIFFERENCES FROM PRODUCTION:
#    - Use TEST Stripe keys (not live keys)
#    - Separate database (never use production database)
#    - More verbose logging (DEBUG level)
#    - May have experimental features enabled
#    - Lower rate limits (optional)
#    - Smaller instance sizes (optional)
#
# 3. SAME AS PRODUCTION:
#    - Code version (deploy from same branch/commit)
#    - Architecture (same number of services)
#    - External services (same providers)
#    - Security measures (same hardening)
#
# 4. TESTING CHECKLIST:
#    - Deploy to staging first
#    - Run automated tests
#    - Manual QA testing
#    - Test payment flows (use Stripe test cards)
#    - Test email delivery
#    - Test push notifications
#    - Load testing (optional)
#    - Security testing (optional)
#    - Then deploy to production
#
# 5. DATA MANAGEMENT:
#    - Periodically reset staging database (weekly/monthly)
#    - Use anonymized production data for realistic testing
#    - Don't use real user emails (use test emails)
#    - Regularly clean up test data
#
# 6. ACCESS CONTROL:
#    - Staging should be password-protected or IP-restricted
#    - Use basic auth or SSO for access control
#    - Don't expose staging URLs publicly
#    - Monitor staging for unusual activity
#
# 7. DEPLOYMENT WORKFLOW:
#    - Feature branch → CI tests → Staging → Manual QA → Production
#    - Use same deployment process as production
#    - Automate staging deployments (on PR merge to staging branch)
#    - Manual approval required for production deployment
#
# 8. MONITORING:
#    - Same monitoring as production (Sentry, logs, uptime)
#    - Different alert channels (e.g., Slack #staging-alerts)
#    - Lower alert thresholds (catch issues early)
#
# 9. DOCUMENTATION:
#    - Keep staging config documented
#    - Document differences from production
#    - Update runbooks with staging-specific procedures
#
# =============================================================================
