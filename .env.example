# Database
DATABASE_URL="postgresql://user:password@localhost:5432/golf_tournament?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# Brevo (Sendinblue) Email Service
BREVO_API_KEY="your-brevo-api-key"
BREVO_SENDER_EMAIL="noreply@golfplatz-siek.de"
BREVO_SENDER_NAME="Golfplatz Siek"

# Brevo Contact Lists (create these in Brevo dashboard)
BREVO_LIST_ALL_MEMBERS=""
BREVO_LIST_ACTIVE_PLAYERS=""
BREVO_LIST_TOURNAMENT_PARTICIPANTS=""

# Brevo Email Templates (create these in Brevo dashboard)
BREVO_TEMPLATE_REGISTRATION_CONFIRMATION=""
BREVO_TEMPLATE_TOURNAMENT_REMINDER=""
BREVO_TEMPLATE_TOURNAMENT_STARTED=""
BREVO_TEMPLATE_TOURNAMENT_RESULTS=""
BREVO_TEMPLATE_SCORECARD_SUBMITTED=""
BREVO_TEMPLATE_PAYMENT_CONFIRMATION=""
BREVO_TEMPLATE_WELCOME=""

# Stripe Payment Integration
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxx"

# PC Caddie Integration (optional)
PC_CADDIE_API_URL="https://api.pc-caddie.de"
PC_CADDIE_API_KEY="your-api-key"
PC_CADDIE_CLUB_ID="your-club-id"

# WHS/DGV Integration (optional)
DGV_API_URL="https://api.dgv.de"
DGV_CLUB_NUMBER="your-club-number"
DGV_API_KEY="your-api-key"

# Monitoring (optional)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Feature Flags
FEATURE_QR_SCORING="true"
FEATURE_LIVE_LEADERBOARD="true"
FEATURE_SPONSOR_ACTIVATION="false"

# Web Push Notifications (VAPID)
# Generate keys with: pnpm generate-vapid
VAPID_PUBLIC_KEY="your-vapid-public-key-here"
VAPID_PRIVATE_KEY="your-vapid-private-key-here"
VAPID_SUBJECT="mailto:admin@golf-siek.de"

# Cron Jobs (for scheduled notifications)
CRON_SECRET="your-cron-secret-key"

# Multi-Club Support
NEXT_PUBLIC_MAIN_DOMAIN="golf-tournament.com"
STRIPE_PRICE_BASIC="price_xxxxx"
STRIPE_PRICE_PREMIUM="price_xxxxx"
STRIPE_PRICE_ENTERPRISE="price_xxxxx"

# Photo Upload Storage
UPLOAD_MAX_SIZE="10485760" # 10MB in bytes
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,image/webp"
